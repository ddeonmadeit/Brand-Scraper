PORT=3000

# ── Gmail OAuth2 (sends from your actual Gmail) ───────────────────────────
# Setup: console.cloud.google.com → New project → Enable Gmail API
#        → Credentials → OAuth 2.0 Client ID (Web app)
#        → Add redirect URI: https://YOUR-RAILWAY-URL/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://your-app.up.railway.app

# ── Resend fallback (if Gmail not connected) ──────────────────────────────
# Free at resend.com
RESEND_API_KEY=
